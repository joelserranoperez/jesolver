# Cadena de conexión a PostgreSQL. Copia este fichero a .env y ajústala.
# - Docker (docker compose up -d):  postgresql://planificador:planificador@localhost:5432/planificador
# - Neon / Supabase: pega la cadena que te da el panel (incluye ?sslmode=require)
DATABASE_URL=postgresql://planificador:planificador@localhost:5432/planificador
